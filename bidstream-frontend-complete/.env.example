# ---------------------------------------------------------------------------
# BidStream Frontend - Environment Configuration
# Copy this file to `.env` (or `.env.local`) and adjust values as needed.
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# ---------------------------------------------------------------------------

# API Gateway base URL.
#   - Leave EMPTY in development to use the Vite dev proxy (/api -> localhost:8080)
#   - Set to the gateway origin in production, e.g. https://api.example.com
VITE_API_URL=

# Optional: override the gateway target used by the Vite dev server proxy
# (only used by vite.config.ts on the dev server, not the browser bundle).
# VITE_PROXY_TARGET=http://localhost:8080

# Environment
VITE_ENV=development

# Enable/Disable Features
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_REAL_TIME_UPDATES=true

# Polling Intervals (in milliseconds)
VITE_NOTIFICATION_POLL_INTERVAL=30000
VITE_BID_POLL_INTERVAL=3000
VITE_AUCTION_POLL_INTERVAL=5000

# WebSocket (STOMP) endpoint for live notifications (relative, proxied in dev).
VITE_WS_URL=/ws
